rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Live Leaderboard Collection
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Activity Sessions Collection
    match /activity_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Coin Transactions Collection (Immutable)
    match /coin_transactions/{transactionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Withdrawals / Payout Requests Collection
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
