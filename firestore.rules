rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. User Profile Collection (Stores Profile, Coins, Steps, Referral, Sneakers, Water)
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 2. Live Leaderboard Collection (Real-time Global Rankings)
    match /leaderboard/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Coin Transactions Collection (All Earned & Spent Coin Logs)
    match /coin_transactions/{txId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // 4. Withdrawal Payout Requests Collection (PayPal Cashout Logs)
    match /withdrawals/{withdrawalId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // 5. Activity Tracking Sessions Collection (GPS Workouts, Steps, Distance)
    match /activity_sessions/{sessionId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // 6. Remote App Configuration (Maintenance Mode & Remote Control)
    match /app_config/settings {
      allow read: if true; // Public read so app can check maintenance status even before login
      allow write: if false; // Only editable directly from Firebase Admin Console
    }
  }
}
